<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Panchify" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorSecondary">@color/spotify_green</item>
        <item name="colorTertiary">@color/spotify_green</item>
        <item name="colorAccent">@color/spotify_green</item>
        <item name="colorControlActivated">@color/spotify_green</item>
    </style>

    <style name="Theme.Panchify" parent="Base.Theme.Panchify" />

    <style name="BottomNavText.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavText.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
    </style>
</resources>
